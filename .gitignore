# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# amplify
.amplify
amplify_outputs*
amplifyconfiguration*

# Cloudflare Pages local dev secrets - never commit
.dev.vars

# Wrangler local dev state
.wrangler

# Local-only wrangler config
wrangler.toml

# Secrets. The .dev.vars rule above only covers that exact filename, so these
# patterns catch the file that does not exist yet. This repo is public, so a
# single "git add ." that swept up a .env would be world-readable and scraped
# by automated secret crawlers within minutes.
.env
.env.*
!.env.example
.dev.vars.*
!.dev.vars.example
*.pem
*.key
secrets.json
